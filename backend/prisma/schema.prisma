// ReachInbox data model.
// PostgreSQL is the source of truth. Redis/BullMQ holds transient queue state and
// Elasticsearch holds a searchable copy of emails. Keep this schema in sync with
// the TypeScript services.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum CampaignStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

enum OAuthProvider {
  GOOGLE
  SLACK
}

enum OAuthStatus {
  CONNECTED
  REVOKED
  ERROR
}

enum DeliveryStatus {
  SUCCESS
  FAILURE
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String?
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders            Sender[]
  campaigns          Campaign[]
  emails             Email[]
  oauthConnections   OAuthConnection[]
  idempotencyRecords IdempotencyRecord[]

  @@index([email])
}

// A sender is an SMTP identity. Senders with a null userId are shared system
// senders seeded from environment variables (for example Ethereal sandbox).
model Sender {
  id                String   @id @default(cuid())
  userId            String?
  name              String
  email             String   @unique
  smtpHost          String
  smtpPort          Int      @default(587)
  smtpSecure        Boolean  @default(false)
  smtpUser          String
  smtpPassEncrypted String
  isActive          Boolean  @default(true)
  isShared          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  emails    Email[]

  @@index([userId])
  @@index([isActive])
}

model Campaign {
  id              String         @id @default(cuid())
  userId          String
  senderId        String
  subject         String
  body            String
  startAt         DateTime
  delayMs         Int
  hourlyLimit     Int
  status          CampaignStatus @default(SCHEDULED)
  totalRecipients Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender  @relation(fields: [senderId], references: [id])
  emails Email[]

  @@index([userId, createdAt])
  @@index([status])
}

model Email {
  id              String      @id @default(cuid())
  campaignId      String?
  userId          String
  senderId        String
  recipient       String
  recipientName   String?
  subject         String
  body            String
  status          EmailStatus @default(SCHEDULED)
  scheduledAt     DateTime
  sentAt          DateTime?
  attempts        Int         @default(0)
  lastError       String?
  messageId       String?
  previewUrl      String?
  bullJobId       String      @unique
  searchIndexedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  campaign         Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender           Sender            @relation(fields: [senderId], references: [id])
  deliveryAttempts DeliveryAttempt[]

  @@index([userId, status, scheduledAt])
  @@index([campaignId])
  @@index([recipient])
  @@index([senderId, status])
  @@index([searchIndexedAt])
}

model DeliveryAttempt {
  id            String         @id @default(cuid())
  emailId       String
  attemptNumber Int
  status        DeliveryStatus
  smtpResponse  String?
  error         String?
  startedAt     DateTime       @default(now())
  finishedAt    DateTime?
  createdAt     DateTime       @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([emailId, attemptNumber])
  @@index([emailId, createdAt])
}

model OAuthConnection {
  id                   String       @id @default(cuid())
  userId               String
  provider             OAuthProvider
  providerAccountId    String?
  accessTokenEncrypted String
  refreshTokenEncrypted String?
  tokenType            String?
  scope                String?
  expiresAt            DateTime?
  status               OAuthStatus  @default(CONNECTED)
  metadata             Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider, status])
}

model IdempotencyRecord {
  id          String            @id @default(cuid())
  userId      String
  key         String
  requestHash String
  status      IdempotencyStatus @default(PROCESSING)
  response    Json?
  createdAt   DateTime          @default(now())
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
}
