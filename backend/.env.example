# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Must match the frontend origin exactly (credentials/cookies are enabled).
FRONTEND_URL=http://localhost:5173
# Public URL of this backend (used as the default OAuth callback base).
BACKEND_URL=http://localhost:4000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database / cache / search
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_EMAILS_INDEX=reachinbox-emails

# ---------------------------------------------------------------------------
# Security (CHANGE THESE BEFORE DEPLOYING)
# ---------------------------------------------------------------------------
# At least 32 random characters. Example: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-session-secret
# 32-byte key as hex (64 chars) or any long random string. Used for AES-256-GCM
# encryption of SMTP passwords and OAuth tokens. Example: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
SESSION_TTL_HOURS=168
# Set to true when serving over HTTPS. Keep false for local http://localhost.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Google OAuth 2.0
# Authorized redirect URI:
#   http://localhost:4000/api/auth/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ---------------------------------------------------------------------------
# Slack OAuth 2.0
# Redirect URL:
#   http://localhost:4000/api/slack/callback
# Bot scopes: chat:write, team:read (add channels:read if you list channels)
# ---------------------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
# Channel ID (for example C0123456789) where hourly-limit alerts are posted.
SLACK_NOTIFICATION_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Queue / worker / rate limiting
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=2
MIN_DELAY_BETWEEN_EMAILS_MS=1000
MAX_EMAILS_PER_HOUR_PER_SENDER=100
# Number of SMTP attempts per email (transient failures only).
MAX_EMAIL_ATTEMPTS=3
# Processing records older than this are considered crash-orphaned.
STALE_PROCESSING_MINUTES=10

# ---------------------------------------------------------------------------
# Queue dashboard (/admin/queues). Leave blank to require a logged-in session.
# ---------------------------------------------------------------------------
QUEUE_DASHBOARD_USER=
QUEUE_DASHBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# SMTP senders seeded into PostgreSQL on backend startup.
# You may configure up to SENDER_COUNT senders using SENDER_1_*, SENDER_2_*, ...
# Any real SMTP provider works with the same variables.
# ---------------------------------------------------------------------------
SENDER_COUNT=1
SENDER_1_NAME=ReachInbox Sandbox
SENDER_1_EMAIL=replace-with-your-ethereal-address@ethereal.email
SENDER_1_SMTP_HOST=smtp.ethereal.email
SENDER_1_SMTP_PORT=587
SENDER_1_SMTP_SECURE=false
SENDER_1_SMTP_USER=replace-with-your-ethereal-user
SENDER_1_SMTP_PASS=replace-with-your-ethereal-password

# Optional second sender example:
# SENDER_2_NAME=Second Sender
# SENDER_2_EMAIL=second@example.com
# SENDER_2_SMTP_HOST=smtp.example.com
# SENDER_2_SMTP_PORT=587
# SENDER_2_SMTP_SECURE=false
# SENDER_2_SMTP_USER=
# SENDER_2_SMTP_PASS=

# When true, the backend creates a fresh Ethereal test account if no sender is
# configured and seeds it as a shared sender. This is a real Ethereal account
# created through Nodemailer's test account API (credentials are not hardcoded).
USE_ETHEREAL_FALLBACK=true
