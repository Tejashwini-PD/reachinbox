{
  "name": "@reachinbox/backend",
  "version": "1.0.0",
  "private": true,
  "description": "ReachInbox email scheduler API and worker",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/jobs/email.worker.ts",
    "worker:prod": "node dist/jobs/email.worker.js",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "reindex": "tsx src/scripts/reindex.ts",
    "ethereal:create": "tsx src/scripts/create-ethereal.ts",
    "senders:sync": "tsx src/scripts/sync-senders.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.7.10",
    "@bull-board/express": "^6.7.10",
    "@elastic/elasticsearch": "^8.17.0",
    "@prisma/client": "^6.2.1",
    "bullmq": "^5.34.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "nodemailer": "^6.9.16",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
